# Copy to .env and fill in values

# Both JDBC and postgresql:// URLs work
DATABASE_URL=postgresql://user:password@localhost:5432/blog
# Set to production when deployed so the sign-in cookie is only sent over HTTPS
NODE_ENV=development
PORT=3000
# Production behind a reverse proxy: number of proxies in front of the app
# TRUST_PROXY=1
# Name shown in the header and page titles
# SITE_NAME=wildanaizzaddin.
# Cloudflare Turnstile on the response and sign-in forms. Leave both empty to turn it off.
# TURNSTILE_SITE_KEY=0x4AAAAAAFWu-VK6DsOxkZvz
# TURNSTILE_SECRET_KEY=
# Sites the form is served from, comma-separated. Empty: the address the form was opened on.
# TURNSTILE_HOSTNAMES=
