<%- include('partials/head', { title }) %>
<%
  const field = 'autogrow block w-full resize-none overflow-hidden border-0 bg-transparent p-0 text-ink placeholder:text-ink-soft/80 focus:outline-none';
  const panel = 'rounded-md border border-rule bg-surface p-5';
  const published = post && post.status === 'published';
%>
<form id="story-form" data-editor-form class="mx-auto grid max-w-[1040px] items-start gap-10 pt-10 pb-16 lg:grid-cols-[minmax(0,680px)_280px] lg:justify-between" method="post" action="<%= post && post.id ? `/write/${post.id}` : '/write' %>">
  <div class="min-w-0">
    <% if (error) { %><p class="mb-6 border-l-[3px] border-ink bg-wash px-4 py-3" role="alert"><%= error %></p><% } %>
    <label class="sr-only" for="title">Title</label>
    <textarea id="title" name="title" rows="1" class="editor-title <%= field %> text-[clamp(2.125rem,6.5vw,3rem)] leading-[1.1] font-light tracking-[-0.025em]" placeholder="Title" required><%= post ? post.title : '' %></textarea>
    <label class="sr-only" for="subtitle">Subtitle</label>
    <textarea id="subtitle" name="subtitle" rows="1" class="editor-subtitle <%= field %> mt-3 text-[1.375rem] leading-[1.4] text-ink-soft" placeholder="Subtitle (optional)"><%= post ? post.subtitle : '' %></textarea>

    <%- include('partials/rich-editor', { html: post ? post.body_html : '', placeholder: 'Tell your story…', label: 'Story' }) %>
  </div>

  <aside class="grid gap-5 lg:sticky lg:top-6">
    <section class="<%= panel %>" aria-labelledby="publish-title">
      <h2 id="publish-title" class="text-base font-medium">Publish</h2>
      <p class="mt-1 <%= ui.quiet %>">
        <% if (published) { %>Published <%= formatDate(post.published_at) %><% } else if (post && post.id) { %>Draft, last saved <%= formatDate(post.updated_at) %><% } else { %>New story, not saved yet<% } %>
      </p>
      <div class="mt-4 grid gap-2">
        <button class="<%= ui.button %>" type="submit" name="action" value="publish"><%= published ? 'Update' : 'Publish' %></button>
        <button class="<%= ui.buttonQuiet %>" type="submit" name="action" value="draft"><%= published ? 'Unpublish to drafts' : 'Save draft' %></button>
      </div>
    </section>

    <section class="<%= panel %>" aria-labelledby="cover-title">
      <h2 id="cover-title" class="text-base font-medium">Cover image</h2>
      <%- include('partials/image-field', { name: 'cover_url', value: post && post.cover_url, alt: 'Cover image preview', shape: 'aspect-[3/2] w-full rounded-sm' }) %>
      <p class="mt-3 <%= ui.quiet %>">Shown in story lists. Without one, the first image in your story is used.</p>
    </section>

    <section class="<%= panel %>">
      <label class="block text-base font-medium" for="tags">Topics</label>
      <input class="mt-3 <%= ui.input %>" id="tags" name="tags" placeholder="e.g. JavaScript, Habits" value="<%= post && post.tags ? post.tags.map((t) => t.name).join(', ') : '' %>">
      <p class="mt-2 <%= ui.quiet %>">Up to 5, separated by commas.</p>
    </section>
  </aside>
</form>
<%- include('partials/foot', { scripts: ['/editor.js'] }) %>
