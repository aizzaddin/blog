<%- include('partials/head', { title, description }) %>
<div class="progress pointer-events-none fixed inset-x-0 top-0 z-5 h-[3px]" aria-hidden="true"><span class="block h-full w-full origin-left scale-x-0 bg-ink-soft"></span></div>
<article class="story <%= ui.column %>">
  <header class="pt-14 pb-2 max-sm:pt-9">
    <h1 class="<%= ui.storyTitle %>"><%= post.title %></h1>
    <% if (post.subtitle) { %><p class="mt-3 text-[1.375rem] leading-[1.4] text-ink-soft max-sm:text-xl"><%= post.subtitle %></p><% } %>
    <p class="mt-4 <%= ui.meta %>">
      <time datetime="<%= new Date(post.published_at).toISOString() %>"><%= formatDate(post.published_at) %></time>
      <span><%= post.reading_min %> min read</span>
    </p>
  </header>

  <div class="prose"><%- html %></div>

  <footer class="mt-12">
    <% if (post.tags.length) { %>
      <p class="mb-8 text-ink-soft">Filed under <% post.tags.forEach((t, i) => { %><%= i ? ', ' : '' %><a class="<%= ui.tag %>" href="/tag/<%= t.slug %>"><%= t.name %></a><% }) %></p>
    <% } %>

    <div class="clap group relative flex items-center gap-2.5 border-y border-rule py-4" data-slug="<%= post.slug %>">
      <button type="button" class="clap-button grid size-[52px] cursor-pointer place-items-center rounded-full border border-rule bg-surface text-ink-soft transition hover:border-ink hover:text-ink active:scale-92 group-data-clapped:border-ink group-data-clapped:bg-ink group-data-clapped:text-paper group-data-clapped:hover:text-paper" aria-label="Clap for this story">
        <%- include('partials/clap-icon', { size: 26 }) %>
      </button>
      <span class="clap-count text-[0.9375rem] text-ink-soft tabular-nums" aria-live="polite"><%= post.claps %></span>
      <span class="clap-burst pointer-events-none absolute -top-1.5 left-2 min-w-9 rounded-full bg-ink px-2 py-0.5 text-center text-xs text-paper opacity-0" aria-hidden="true"></span>
    </div>

  </footer>

  <section class="mt-4 py-10" id="responses" aria-labelledby="responses-title">
    <h2 id="responses-title" class="mb-5 text-xl font-semibold">Responses <span class="font-normal text-ink-soft"><%= replies.length %></span></h2>
    <form class="mb-6 grid gap-2.5" method="post" action="/p/<%= post.slug %>/responses">
      <label class="sr-only" for="r-name">Name</label>
      <input class="<%= ui.input %>" id="r-name" name="name" maxlength="60" required placeholder="Your name" autocomplete="name">
      <label class="sr-only" for="r-body">Response</label>
      <textarea class="<%= ui.input %>" id="r-body" name="body" rows="3" maxlength="2000" required placeholder="What are your thoughts?"></textarea>
      <button class="justify-self-end <%= ui.button %>" type="submit">Post response</button>
    </form>
    <% if (!replies.length) { %><p class="<%= ui.quiet %>">No responses yet. Start the conversation.</p><% } %>
    <ol>
      <% replies.forEach((r) => { %>
        <li class="border-t border-rule py-5">
          <p class="mb-1.5 flex items-baseline gap-3 text-sm"><strong class="font-semibold"><%= r.name %></strong> <time class="text-ink-soft" datetime="<%= new Date(r.created_at).toISOString() %>"><%= formatDate(r.created_at) %></time></p>
          <p class="text-[1.0625rem] whitespace-pre-line"><%= r.body %></p>
        </li>
      <% }) %>
    </ol>
  </section>

  <% if (more.length) { %>
    <section class="border-t border-rule pt-10 pb-4" aria-labelledby="more-title">
      <h2 id="more-title" class="mb-2 text-xl font-semibold">More stories</h2>
      <ul>
        <% more.forEach((p) => { %><%- include('partials/row', { p }) %><% }) %>
      </ul>
    </section>
  <% } %>
</article>
<%- include('partials/foot') %>
