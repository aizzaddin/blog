<%- include('partials/head', { title }) %>
<%
  const field = 'autogrow block w-full resize-none overflow-hidden border-0 bg-transparent p-0 text-ink placeholder:text-ink-soft/80 focus:outline-none';
  const panel = 'rounded-md border border-rule bg-surface p-5';
%>
<form data-editor-form class="mx-auto grid max-w-[1040px] items-start gap-10 pt-10 pb-16 lg:grid-cols-[minmax(0,680px)_280px] lg:justify-between" method="post" action="<%= page.id ? `/pages/${page.id}/edit` : '/pages/new' %>">
  <div class="min-w-0">
    <% if (error) { %><p class="mb-6 border-l-[3px] border-ink bg-wash px-4 py-3" role="alert"><%= error %></p><% } %>
    <label class="sr-only" for="title">Title</label>
    <textarea id="title" name="title" rows="1" maxlength="120" class="editor-title <%= field %> text-[clamp(2rem,6vw,2.75rem)] leading-[1.08] font-semibold tracking-[-0.03em]" placeholder="Page title" required><%= page.title %></textarea>

    <%- include('partials/rich-editor', { html: page.body_html, placeholder: 'Write the page…', label: 'Page' }) %>
  </div>

  <aside class="grid gap-5 lg:sticky lg:top-6">
    <section class="<%= panel %>">
      <h2 class="text-base font-medium">Save</h2>
      <p class="mt-1 <%= ui.quiet %>"><%= page.id ? 'Changes show on the page right away.' : 'The page is public as soon as you save it.' %></p>
      <div class="mt-4 grid gap-2">
        <button class="<%= ui.button %>" type="submit">Save page</button>
        <a class="<%= ui.buttonQuiet %>" href="/pages">Cancel</a>
      </div>
    </section>

    <section class="<%= panel %> grid gap-4">
      <div class="grid gap-2">
        <label class="font-medium" for="slug">Address</label>
        <div class="flex items-center rounded-md border border-rule bg-surface focus-within:border-ink">
          <span class="pl-3.5 text-ink-soft" aria-hidden="true">/</span>
          <input class="w-full bg-transparent py-3 pr-3.5 pl-0.5 text-base text-ink placeholder:text-ink-soft/80 focus:outline-none" id="slug" name="slug" maxlength="80" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="made from the title" value="<%= page.slug %>">
        </div>
        <p class="<%= ui.quiet %>">Letters, numbers and dashes, like now or reading-list.</p>
      </div>
      <label class="flex items-start gap-2.5">
        <input class="mt-1 size-4 accent-ink" type="checkbox" name="in_menu" <%= page.in_menu ? 'checked' : '' %>>
        <span><span class="font-medium">Show in the menu</span><span class="block <%= ui.quiet %>">Adds a link to this page in the header. Set the order on the Pages list.</span></span>
      </label>
    </section>

    <% if (page.id) { %>
      <section class="<%= panel %>">
        <h2 class="text-base font-medium">Delete page</h2>
        <p class="mt-1 <%= ui.quiet %>">Removes the page and its address for good.</p>
        <button class="mt-4 w-full <%= ui.buttonQuiet %>" type="submit" form="delete-page">Delete page</button>
      </section>
    <% } %>
  </aside>
</form>
<% if (page.id) { %>
  <form id="delete-page" method="post" action="/pages/<%= page.id %>/delete" data-confirm="Delete “<%= page.title %>”? This can’t be undone."></form>
<% } %>
<%- include('partials/foot', { scripts: ['/editor.js'] }) %>
