<%- include('partials/head', { title }) %>
<% const panel = 'rounded-md border border-rule bg-surface p-5'; %>
<form data-editor-form class="mx-auto grid max-w-[1040px] items-start gap-10 pt-10 pb-16 lg:grid-cols-[minmax(0,680px)_280px] lg:justify-between" method="post" action="/about/edit">
  <div class="min-w-0">
    <% if (error) { %><p class="mb-6 border-l-[3px] border-ink bg-wash px-4 py-3" role="alert"><%= error %></p><% } %>
    <h1 class="text-[clamp(2.125rem,6.5vw,3rem)] leading-[1.1] font-light tracking-[-0.025em]">About page</h1>
    <p class="mt-2 text-ink-soft">Tell readers who you are and what you write about.</p>
    <div class="mt-6">
      <%- include('partials/rich-editor', { html: owner.about_html, placeholder: 'Introduce yourself…', label: 'About you' }) %>
    </div>
  </div>

  <aside class="grid gap-5 lg:sticky lg:top-6">
    <section class="<%= panel %>">
      <h2 class="text-base font-medium">Save</h2>
      <p class="mt-1 <%= ui.quiet %>">Changes show on your about page right away.</p>
      <div class="mt-4 grid gap-2">
        <button class="<%= ui.button %>" type="submit">Save changes</button>
        <a class="<%= ui.buttonQuiet %>" href="/about">Cancel</a>
      </div>
    </section>

    <section class="<%= panel %> grid gap-4">
      <div class="grid gap-2">
        <label class="font-medium" for="name">Name</label>
        <input class="<%= ui.input %>" id="name" name="name" maxlength="80" required value="<%= owner.name %>">
      </div>
      <div class="grid gap-2">
        <label class="font-medium" for="bio">Short bio</label>
        <textarea class="<%= ui.input %>" id="bio" name="bio" rows="3" maxlength="200"><%= owner.bio %></textarea>
        <p class="<%= ui.quiet %>">Shown under your name and at the end of every story.</p>
      </div>
    </section>

    <section class="<%= panel %>" aria-labelledby="photo-title">
      <h2 id="photo-title" class="text-base font-medium">Profile photo</h2>
      <%- include('partials/image-field', { name: 'avatar_url', value: owner.avatar_url, alt: 'Profile photo preview', shape: 'size-28 rounded-full' }) %>
    </section>
  </aside>
</form>
<%- include('partials/foot', { scripts: ['/editor.js'] }) %>
