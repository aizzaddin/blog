<% const body = streamBody(p); %>
<article class="stream-entry pb-20 max-sm:pb-14">
  <h2 class="<%= ui.storyTitle %>">
    <a class="decoration-2 underline-offset-[6px] hover:underline" href="/p/<%= p.slug %>"><%= p.title %></a>
  </h2>
  <% if (p.subtitle) { %><p class="mt-2.5 text-xl leading-[1.4] text-ink-soft max-sm:text-lg"><%= p.subtitle %></p><% } %>
  <p class="mt-3 <%= ui.meta %>">
    <a class="hover:text-ink" href="/p/<%= p.slug %>"><time datetime="<%= new Date(p.published_at).toISOString() %>"><%= formatDate(p.published_at) %></time></a>
    <span><%= p.reading_min %> min read</span>
  </p>
  <% if (p.cover_url) { %>
    <a class="mt-10 mb-4 block" href="/p/<%= p.slug %>" tabindex="-1" aria-hidden="true">
      <img class="mx-auto h-auto max-w-full rounded-sm" src="<%= p.cover_url %>" alt="" loading="lazy">
    </a>
  <% } %>
  <div class="prose"><%- body.html %></div>
  <% if (body.cut) { %>
    <p class="mt-8"><a class="font-semibold underline decoration-1 underline-offset-[3px] hover:decoration-2" href="/p/<%= p.slug %>">Continue reading</a></p>
  <% } %>
</article>
