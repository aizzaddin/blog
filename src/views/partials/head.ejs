<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} — ${siteName}` : siteName %></title>
  <% if (typeof description !== 'undefined') { %><meta name="description" content="<%= description %>"><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Roboto+Mono:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  <meta name="color-scheme" content="light dark">
  <script>
    // Apply the reader's saved theme before the page paints, so it never flashes.
    try {
      const theme = localStorage.getItem('theme');
      if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
    } catch {}
  </script>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="bg-paper font-sans text-[15px] leading-normal text-ink antialiased">
  <a class="absolute top-2 -left-[999px] z-10 bg-ink px-2.5 py-1.5 text-paper focus:left-2" href="#content">Skip to content</a>
  <header class="grid h-16 grid-cols-[1fr_auto_1fr] items-center gap-x-4 border-b border-rule px-6 max-sm:h-auto max-sm:grid-cols-2 max-sm:gap-y-2 max-sm:px-4 max-sm:py-3">
    <a class="col-start-2 row-start-1 text-[1.5rem] leading-none font-normal tracking-[-0.02em] whitespace-nowrap max-sm:col-span-2 max-sm:col-start-1 max-sm:justify-self-center max-sm:text-xl" href="/"><%= siteName %></a>
    <%
      const navLink = (href, label) => {
        const current = currentPath === href || (href !== '/' && currentPath.startsWith(href + '/'));
        return `<a class="${current ? 'text-ink' : 'hover:text-ink'}" href="${href}"${current ? ' aria-current="page"' : ''}>${label}</a>`;
      };
    %>
    <div class="col-start-1 row-start-1 flex items-center justify-self-start text-ink-soft max-sm:row-start-2">
      <button type="button" class="grid size-8 cursor-pointer place-items-center rounded-full hover:bg-wash hover:text-ink" data-theme-toggle hidden>
        <span data-show-when="dark"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span>
        <span data-show-when="light"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg></span>
      </button>
    </div>
    <div class="col-start-3 row-start-1 flex items-center gap-5 justify-self-end text-ink-soft max-sm:col-start-2 max-sm:row-start-2 max-sm:gap-3.5 max-sm:text-sm">
      <nav class="flex items-center gap-5 max-sm:gap-3.5" aria-label="Main">
        <%- navLink('/topics', 'Topics') %>
        <%- navLink('/about', 'About') %>
      </nav>
      <% if (me) { %>
        <span class="h-4 w-px bg-rule" aria-hidden="true"></span>
        <nav class="flex items-center gap-5 max-sm:gap-3.5" aria-label="Writing">
          <%- navLink('/drafts', 'Drafts') %>
          <a class="inline-flex items-center gap-1.5 <%= currentPath.startsWith('/write') ? 'text-ink' : 'hover:text-ink' %>" href="/write">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9l-4-4L4 16v4z"/><path d="M13.5 6.5l4 4"/></svg>
          Write
        </a>
        </nav>
        <form method="post" action="/logout">
          <button class="cursor-pointer hover:text-ink" type="submit" title="Signed in as <%= me.name %>">Sign out</button>
        </form>
      <% } %>
    </div>
  </header>
  <main id="content" class="px-6 max-sm:px-4">
