<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%# Each page's tab shows just its own title; the home page shows the writer's name. %>
  <title><%= title || (siteOwner ? siteOwner.name : siteName) %></title>
  <% if (typeof description !== 'undefined') { %><meta name="description" content="<%= description %>"><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Libre+Franklin:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Roboto+Mono:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  <meta name="color-scheme" content="light dark">
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <link rel="stylesheet" href="<%= asset('style.css') %>">
</head>
<body class="bg-paper font-sans text-[15px] leading-normal text-ink antialiased">
  <a class="absolute top-2 -left-[999px] z-10 bg-ink px-2.5 py-1.5 text-paper focus:left-2" href="#content">Skip to content</a>
  <%
    const isCurrent = (href) => currentPath === href || currentPath.startsWith(href + '/');
    const links = menuPages.map((p) => ({ href: `/${p.slug}`, label: p.title }))
      .concat(me ? [{ href: '/drafts', label: 'Drafts' }, { href: '/pages', label: 'Pages' }, { href: '/write', label: 'Write' }] : []);
    const isHome = currentPath === '/';
  %>
  <header id="top" class="border-b border-rule px-6 text-center max-sm:px-4 <%= isHome ? 'pt-12 pb-10 max-sm:pt-9 max-sm:pb-8' : 'pt-8 pb-6 max-sm:pt-6 max-sm:pb-5' %>">
    <%# The photo only greets readers on the home page; elsewhere the header stays short. %>
    <% if (isHome && siteOwner && siteOwner.avatar_url) { %>
      <a class="mx-auto mb-5 block size-24 overflow-hidden rounded-full bg-wash max-sm:size-20" href="/about" aria-label="About <%= siteOwner.name %>">
        <img class="size-full object-cover" src="<%= siteOwner.avatar_url %>" alt="">
      </a>
    <% } %>
    <a class="text-[1.375rem] leading-none font-semibold tracking-[-0.02em] hover:text-ink-soft" href="/"><%= siteName %></a>

    <nav class="mt-3.5 flex flex-wrap items-center justify-center gap-x-5 gap-y-1 text-ink-soft" aria-label="Main">
      <% links.forEach((l) => { %>
        <a class="border-b-2 border-transparent pb-0.5 hover:border-rule hover:text-ink aria-[current=page]:border-ink aria-[current=page]:text-ink" href="<%= l.href %>"<%- isCurrent(l.href) ? ' aria-current="page"' : '' %>><%= l.label %></a>
      <% }) %>
      <% if (me) { %>
        <form method="post" action="/logout">
          <button class="cursor-pointer border-b-2 border-transparent pb-0.5 hover:border-rule hover:text-ink" type="submit" title="Signed in as <%= me.name %>">Sign out</button>
        </form>
      <% } %>
    </nav>
  </header>
  <main id="content" class="px-6 max-sm:px-4">
