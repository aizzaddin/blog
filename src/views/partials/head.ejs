<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title ? `${title} — ${siteName}` : siteName %></title>
  <% if (typeof description !== 'undefined') { %><meta name="description" content="<%= description %>"><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Roboto+Mono:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
  <meta name="color-scheme" content="light dark">
  <% if (typeof noindex !== 'undefined' && noindex) { %><meta name="robots" content="noindex, nofollow"><% } %>
  <script>
    // Apply the reader's saved theme before the page paints, so it never flashes.
    try {
      const theme = localStorage.getItem('theme');
      if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
    } catch {}
  </script>
  <link rel="stylesheet" href="<%= asset('style.css') %>">
</head>
<body class="bg-paper font-sans text-[15px] leading-normal text-ink antialiased">
  <a class="absolute top-2 -left-[999px] z-10 bg-ink px-2.5 py-1.5 text-paper focus:left-2" href="#content">Skip to content</a>
  <%
    const isCurrent = (href) => currentPath === href || currentPath.startsWith(href + '/');
    const mainLinks = [{ href: '/topics', label: 'Topics' }, { href: '/about', label: 'About' }];
    const writingLinks = me ? [{ href: '/drafts', label: 'Drafts' }, { href: '/write', label: 'Write', icon: true }] : [];
    const linkAttrs = (l) => `href="${l.href}"${isCurrent(l.href) ? ' aria-current="page"' : ''}`;
    const penIcon = '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h4L19 9l-4-4L4 16v4z"/><path d="M13.5 6.5l4 4"/></svg>';
  %>
  <header class="relative grid h-16 grid-cols-[1fr_auto_1fr] items-center gap-x-4 border-b border-rule px-6 max-sm:h-14 max-sm:px-4" data-site-header>
    <a class="col-start-2 row-start-1 text-[1.5rem] leading-none font-normal tracking-[-0.02em] whitespace-nowrap max-sm:text-xl" href="/"><%= siteName %></a>

    <div class="col-start-1 row-start-1 flex items-center justify-self-start text-ink-soft">
      <button type="button" class="grid size-8 cursor-pointer place-items-center rounded-full hover:bg-wash hover:text-ink" data-theme-toggle hidden>
        <span data-show-when="dark"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span>
        <span data-show-when="light"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg></span>
      </button>
    </div>

    <%# Wide screens: links in a row. %>
    <div class="col-start-3 row-start-1 flex items-center gap-5 justify-self-end text-ink-soft max-sm:hidden">
      <nav class="flex items-center gap-5" aria-label="Main">
        <% mainLinks.forEach((l) => { %><a class="aria-[current=page]:text-ink hover:text-ink" <%- linkAttrs(l) %>><%= l.label %></a><% }) %>
      </nav>
      <% if (me) { %>
        <span class="h-4 w-px bg-rule" aria-hidden="true"></span>
        <nav class="flex items-center gap-5" aria-label="Writing">
          <% writingLinks.forEach((l) => { %><a class="inline-flex items-center gap-1.5 aria-[current=page]:text-ink hover:text-ink" <%- linkAttrs(l) %>><% if (l.icon) { %><%- penIcon %><% } %><%= l.label %></a><% }) %>
        </nav>
        <form method="post" action="/logout">
          <button class="cursor-pointer hover:text-ink" type="submit" title="Signed in as <%= me.name %>">Sign out</button>
        </form>
      <% } %>
    </div>

    <%# Phones: a menu button that opens the links as a dropdown. %>
    <button type="button" class="group col-start-3 row-start-1 grid size-9 cursor-pointer place-items-center justify-self-end rounded-full text-ink-soft hover:bg-wash hover:text-ink aria-expanded:bg-wash aria-expanded:text-ink sm:hidden" aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <svg class="group-aria-expanded:hidden" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      <svg class="hidden group-aria-expanded:block" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <div id="mobile-menu" class="absolute inset-x-0 top-full z-30 border-y border-rule bg-paper px-4 sm:hidden" hidden>
      <nav aria-label="Main">
        <ul>
          <% mainLinks.concat(writingLinks).forEach((l) => { %>
            <li class="border-t border-rule first:border-t-0">
              <a class="flex items-center gap-2 py-3.5 text-base text-ink-soft aria-[current=page]:font-medium aria-[current=page]:text-ink" <%- linkAttrs(l) %>><% if (l.icon) { %><%- penIcon %><% } %><%= l.label %></a>
            </li>
          <% }) %>
        </ul>
      </nav>
      <% if (me) { %>
        <form class="border-t border-rule" method="post" action="/logout">
          <button class="w-full cursor-pointer py-3.5 text-left text-base text-ink-soft hover:text-ink" type="submit">Sign out <span class="text-sm">(<%= me.name %>)</span></button>
        </form>
      <% } %>
    </div>
  </header>
  <main id="content" class="px-6 max-sm:px-4">
