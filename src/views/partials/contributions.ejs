<%#
  GitHub contribution calendar: 53 weeks of 7 days, oldest on the left. On a narrow screen the strip
  scrolls sideways and opens on the most recent weeks (the rtl wrapper starts scrolled to the end).
%>
<section class="mt-14 border-t border-rule pt-10" aria-labelledby="contrib-title">
  <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
    <h2 id="contrib-title" class="text-xl font-semibold">On GitHub</h2>
    <p class="<%= ui.quiet %>">
      <%= cal.total.toLocaleString('en-US') %> contributions in the last year ·
      <a class="<%= ui.tag %>" href="https://github.com/<%= username %>" rel="noopener">@<%= username %></a>
    </p>
  </div>
  <div class="contrib-scroll">
    <div class="contrib" style="--weeks: <%= cal.weeks.length %>">
      <div class="contrib-months" aria-hidden="true">
        <% cal.months.forEach((m) => { %><span style="grid-column: <%= m.index + 1 %>"><%= m.label %></span><% }) %>
      </div>
      <div class="contrib-grid" role="img" aria-label="<%= cal.total.toLocaleString('en-US') %> GitHub contributions in the last year">
        <% cal.weeks.forEach((week) => { week.forEach((d) => { %><% if (d) { %><i class="contrib-day" data-level="<%= d.level %>" title="<%= d.count === 0 ? 'No' : d.count %> contribution<%= d.count === 1 ? '' : 's' %> on <%= d.date %>"></i><% } else { %><i class="contrib-day contrib-pad"></i><% } %><% }) }) %>
      </div>
    </div>
  </div>
  <div class="mt-2 flex items-center justify-end gap-1 text-xs text-ink-soft" aria-hidden="true">
    Less
    <% [0, 1, 2, 3, 4].forEach((l) => { %><i class="contrib-day" data-level="<%= l %>"></i><% }) %>
    More
  </div>
</section>
