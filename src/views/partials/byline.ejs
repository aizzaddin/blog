<span class="inline-grid flex-none place-items-center overflow-hidden rounded-full bg-ink leading-none font-medium tracking-[0.02em] text-paper <%= typeof size !== 'undefined' ? size : 'size-6 text-[0.625rem]' %>" aria-hidden="true"><% if (p.avatar_url) { %><img class="size-full object-cover" src="<%= p.avatar_url %>" alt=""><% } else { %><%= initials(p.author_name) %><% } %></span>
