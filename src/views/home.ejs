<%- include('partials/head', { title }) %>
<div class="pt-14 max-sm:pt-10 <%= ui.column %>">
  <h1 class="sr-only">Stories by <%= siteOwner ? siteOwner.name : siteName %></h1>
  <% if (!list.length) { %>
    <p class="<%= ui.empty %>">No stories published yet.</p>
  <% } %>
  <% list.forEach((p) => { %>
    <%- include('partials/entry', { p }) %>
  <% }) %>
</div>
<%- include('partials/foot') %>
